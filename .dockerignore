# Ignore node_modules and other large directories
node_modules/
**/node_modules/
.git/
.worktrees/
.venv/
**/.venv/
venv/
**/venv/
**/.python_packages/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
dist/
build/
*.egg-info/
.env
.env.*
*.log

# Ignore helm charts and k8s configs (not needed in image)
helm/
k8s/
terraform/
.terraform/

# Ignore docs and tests
docs/
tests/
*.md
!api/*.md

# Keep ingestion sources and the worker project required by root-context builds.
connectors/*
!connectors/ingestion/
connectors/ingestion/*
!connectors/ingestion/dotnet/
!connectors/ingestion/onelake_iceberg/
!connectors/worker/
connectors/worker/*
!connectors/worker/dotnet/

# Ignore CLI (not needed in API image)
cli/

# Ignore scripts (not needed in API image)
scripts/

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore temp files
*.tmp
*.bak
nul

# Ignore large files
*.tar.gz
*.json
!mcp_servers/cosmos/host.json
docgrok/
**/target/
web/static/lib/
.claude/
connectors/ingestion/dotnet/bin/
connectors/ingestion/dotnet/obj/
connectors/worker/dotnet/bin/
connectors/worker/dotnet/obj/
